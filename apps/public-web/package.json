{
  "name": "@voysemble/public-web",
  "version": "0.0.1",
  "private": true,
  "description": "Public marketing site for voysemble.com. Static HTML rendered at build time from a typed content model (EN at /, KO at /ko/); served as an assets-only Worker (ADR-0008).",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @voysemble/design-tokens build",
    "build": "node --no-warnings=ExperimentalWarning scripts/build.ts",
    "dev": "pnpm build && wrangler dev --port 8790 --ip 127.0.0.1",
    "typecheck": "pnpm --filter @voysemble/design-tokens build && tsc -p tsconfig.json",
    "pretest": "pnpm --filter @voysemble/design-tokens build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "og": "node --no-warnings=ExperimentalWarning scripts/og-card.ts"
  },
  "dependencies": {
    "@voysemble/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
