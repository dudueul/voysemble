// Copyright 2026- At Day. All rights reserved.
//
// Customer API Worker config. Environments per ADR-0008. `<build>` placeholders are substituted
// by CI, never by hand. Bindings (D1, DO, R2, KV, Queues) are added by the slices that need them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voysemble-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Slice 054 (D29): the guardian digest run. Every ten minutes the Worker mails the digest-lane
  // rows that came due (the organization's digest hour in the trip's zone); a run with nothing
  // due costs one D1 read. Inherited by the named environments.
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "ENV_NAME": "local", "BUILD_ID": "local" },
  // Global D1: identity, org directory, invites, sessions (ADR-0002). Migrations in ./migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voysemble-local",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  // OrgDO: SQLite-backed canonical store per organization (ADR-0002). Schema managed in-object.
  "durable_objects": {
    "bindings": [
      { "name": "ORG_DO", "class_name": "OrgDurableObject" },
      { "name": "RATE_LIMIT_DO", "class_name": "RateLimitDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OrgDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimitDurableObject"] }
  ],
  // Local-only fixture mailbox for the FixtureEmailPort (magic links land here in dev/tests).
  // Not inherited by named environments: preview/staging/production must bind a real transport.
  "kv_namespaces": [{ "binding": "DEV_MAILBOX", "id": "dev-mailbox-local" }],
  // Photos (D18, slice 043): sealed originals and thumbnails, private (ADR-0002 R2 media).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "voysemble-media-local" }],
  // Organizer console bundle. Asset-first: anything not under run_worker_first is served from
  // dist/ without invoking the Worker (free, cached). SPA fallback for client routes.
  "assets": {
    "directory": "../organizer-web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/openapi.json", "/webhooks/*", "/.well-known/*"]
  },
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "voysemble-__BUILD_ID__",
          "database_id": "__D1_ID__",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ORG_DO", "class_name": "OrgDurableObject" },
          { "name": "RATE_LIMIT_DO", "class_name": "RateLimitDurableObject" }
        ]
      },
      "vars": { "ENV_NAME": "preview", "BUILD_ID": "__BUILD_ID__" },
      // One bucket for every preview build: R2 names cannot carry the build placeholder (letters,
      // digits, hyphens only); objects are keyed by organization and trip anyway.
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "voysemble-media-preview" }],
      // Workers AI for announcement translation (ADR-0006). Through AI Gateway when AI_GATEWAY_ID
      // is set as a var or secret. Absent locally on purpose: tests and dev use the fixture port.
      "ai": { "binding": "AI" },
      // App Links / Universal Links (slice 019) read ANDROID_CERT_SHA256 (comma-separated SHA-256
      // fingerprints of the signing certificates) and APPLE_APP_IDS (TEAMID.com.voysemble.app) from
      // vars set with `wrangler secret put` or the dashboard; unset publishes an empty association.
      "routes": [
        { "pattern": "__BUILD_ID__.dev.voysemble.cfd", "custom_domain": true },
        { "pattern": "api.__BUILD_ID__.dev.voysemble.cfd", "custom_domain": true }
      ]
    },
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "voysemble-staging",
          "database_id": "__D1_ID__",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ORG_DO", "class_name": "OrgDurableObject" },
          { "name": "RATE_LIMIT_DO", "class_name": "RateLimitDurableObject" }
        ]
      },
      "vars": { "ENV_NAME": "staging", "BUILD_ID": "__BUILD_ID__" },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "voysemble-media-staging" }],
      // Workers AI for announcement translation (ADR-0006). Through AI Gateway when AI_GATEWAY_ID
      // is set as a var or secret. Absent locally on purpose: tests and dev use the fixture port.
      "ai": { "binding": "AI" },
      // App Links / Universal Links (slice 019) read ANDROID_CERT_SHA256 (comma-separated SHA-256
      // fingerprints of the signing certificates) and APPLE_APP_IDS (TEAMID.com.voysemble.app) from
      // vars set with `wrangler secret put` or the dashboard; unset publishes an empty association.
      "routes": [
        { "pattern": "staging.dev.voysemble.cfd", "custom_domain": true },
        { "pattern": "api.staging.dev.voysemble.cfd", "custom_domain": true }
      ]
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "voysemble-prod",
          "database_id": "__D1_ID__",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ORG_DO", "class_name": "OrgDurableObject" },
          { "name": "RATE_LIMIT_DO", "class_name": "RateLimitDurableObject" }
        ]
      },
      "vars": { "ENV_NAME": "production", "BUILD_ID": "__BUILD_ID__" },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "voysemble-media-prod" }],
      // Workers AI for announcement translation (ADR-0006). Through AI Gateway when AI_GATEWAY_ID
      // is set as a var or secret. Absent locally on purpose: tests and dev use the fixture port.
      "ai": { "binding": "AI" },
      // App Links / Universal Links (slice 019) read ANDROID_CERT_SHA256 (comma-separated SHA-256
      // fingerprints of the signing certificates) and APPLE_APP_IDS (TEAMID.com.voysemble.app) from
      // vars set with `wrangler secret put` or the dashboard; unset publishes an empty association.
      "routes": [
        { "pattern": "app.voysemble.com", "custom_domain": true },
        { "pattern": "api.voysemble.com", "custom_domain": true }
      ]
    }
  }
}
